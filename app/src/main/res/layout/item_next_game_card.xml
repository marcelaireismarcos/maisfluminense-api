<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/next_game_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/card_margin_horizontal"
    android:layout_marginEnd="@dimen/card_margin_horizontal"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="4dp"
    android:visibility="gone"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/fundo_not"
    app:strokeColor="@color/colorPrimary"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ═══ CABEÇALHO: "⚽ PRÓXIMO JOGO" ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚽"
                android:textSize="16sp"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PRÓXIMO JOGO"
                android:textColor="@color/colorPrimary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"/>

            <!-- Status badge (Ao Vivo, etc) -->
            <com.google.android.material.chip.Chip
                android:id="@+id/ng_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:textSize="9sp"
                android:textColor="@color/white"
                android:visibility="gone"
                app:chipBackgroundColor="@color/colorAccent"
                app:chipMinHeight="22dp"
                app:ensureMinTouchTargetSize="false"
                app:chipCornerRadius="11dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                tools:text="AO VIVO"
                tools:visibility="visible"/>

        </LinearLayout>

        <!-- ═══ TIMES ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <!-- Time da casa -->
            <LinearLayout
                android:id="@+id/ng_home_team"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/ng_home_logo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/ng_home_team_desc"
                    tools:src="@drawable/ic_launcher"/>

                <TextView
                    android:id="@+id/ng_home_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Fluminense"/>

            </LinearLayout>

            <!-- VS badge -->
            <TextView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="VS"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/circular"
                android:backgroundTint="@color/colorPrimary"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>

            <!-- Time visitante -->
            <LinearLayout
                android:id="@+id/ng_away_team"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/ng_away_logo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/ng_away_team_desc"
                    tools:src="@drawable/ic_launcher"/>

                <TextView
                    android:id="@+id/ng_away_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Palmeiras"/>

            </LinearLayout>

        </LinearLayout>

        <!-- ═══ COMPETIÇÃO ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/ng_competition"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="🏆 Brasileirão Série A · Rodada 10"/>

        </LinearLayout>

        <!-- ═══ LOCAL ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/ng_venue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="📍 Maracanã - Rio de Janeiro"/>

        </LinearLayout>

        <!-- ═══ DIVISOR ═══ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:background="@color/surface_divider"
            android:layout_marginBottom="10dp"/>

        <!-- ═══ CONTAGEM REGRESSIVA / DATA ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/ng_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorPrimary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                tools:text="⏰ 3d 14h 32m 15s"/>

            <TextView
                android:id="@+id/ng_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="15/07/2026 · 21:00"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
