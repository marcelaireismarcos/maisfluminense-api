<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/card_margin_horizontal"
    android:layout_marginEnd="@dimen/card_margin_horizontal"
    android:layout_marginTop="@dimen/card_margin_vertical"
    android:layout_marginBottom="@dimen/card_margin_vertical"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/fundo_not"
    app:rippleColor="#33ED8500"
    app:strokeColor="@color/surface_divider"
    app:strokeWidth="0.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/card_padding">

        <!-- Thumbnail — mostrado apenas quando há imagem real -->
        <ImageView
            android:id="@+id/news_thumbnail"
            android:layout_width="match_parent"
            android:layout_height="@dimen/news_thumb_height_maior"
            android:scaleType="fitXY"
            android:background="@drawable/shimmer_rounded"
            android:contentDescription="@string/news01"
            android:visibility="gone"
            android:layout_marginBottom="8dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.NewsThumb"/>

        <!-- Conteúdo principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_marginBottom="4dp">

            <!-- Título (ocupa toda a largura ou deixa espaço para thumbnail) -->
            <TextView
                android:id="@+id/news_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/not_titulo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:ellipsize="end"
                android:paddingEnd="8dp"
                tools:text="Flamengo vence e se mantém na liderança do Brasileirão"/>

            <!-- Thumbnail — mostrado apenas quando há imagem real -->
            <!--<ImageView
                android:id="@+id/news_thumbnail"
                android:layout_width="@dimen/news_thumb_width"
                android:layout_height="@dimen/news_thumb_height"
                android:scaleType="centerCrop"
                android:background="@drawable/shimmer_rounded"
                android:contentDescription="@string/news01"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.NewsThumb"/>-->

        </LinearLayout>

        <!-- Descrição (opcional) -->
        <TextView
            android:id="@+id/news_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone"
            tools:text="Com gol de Danilo Boza no segundo tempo..."/>
        <!-- Linha superior: chip da fonte + tempo relativo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.chip.Chip
                android:id="@+id/news_source_chip"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:textSize="10sp"
                android:textColor="@color/colorPrimary"
                app:chipBackgroundColor="@color/chip_source_background"
                app:chipStrokeColor="@color/colorPrimary"
                app:chipStrokeWidth="0.5dp"
                app:chipMinHeight="26dp"
                app:ensureMinTouchTargetSize="false"
                tools:text="Globo Esporte"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/news_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/feed_date_text"
                tools:text="há 2 horas"/>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
